# .env.example
# Omgevingsvariabelen voor de productie-implementatie op Ubuntu Linux

# Productiemodus (optioneel; Vite regelt dit automatisch bij build, of stel in via systemd/pm2)
# NODE_ENV=production

# Locatie van de SQLite database (Optioneel, standaard is ./database.sqlite)
# Handig voor OVH VPS of Docker persistent volume (bijv: /var/data/database.sqlite)
DATABASE_PATH=./database.sqlite

# Geheime sleutel voor het ondertekenen van JSON Web Tokens (JWT)
# Genereer een veilige willekeurige sleutel op de server met bijvoorbeeld:
# openssl rand -base64 32
JWT_SECRET=vervang_dit_door_een_willekeurige_geheime_sleutel_van_minstens_32_tekens

# ==============================================================================
# CRM & LEDENADMINISTRATIE KLUIS (AES-256-GCM Hardware Encryptie)
# ==============================================================================
# Deze sleutel beveiligt alle gevoelige persoonsgegevens, burgercontacten en financiën.
# Door deze sleutel hier vast te leggen blijft uw kluis intact, ook na git pull of server-updates.
CRM_VAULT_ENCRYPTION_KEY=9a2e13fab2bcda87911d0ddd90289bc954acd422e4b47facd6d00980bff01417

# Standaard wachtwoord voor het hoofdbeheerdersaccount 'admin' (standaard is admin123 indien niet ingesteld)
ADMIN_PASSWORD=admin123

# Stripe Betalingsintegratie voor Ledencontributie (€12,00 per jaar)
# Te vinden in uw Stripe Dashboard: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_vervang_dit_door_uw_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_vervang_dit_door_uw_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_vervang_dit_door_uw_stripe_webhook_secret

# ==============================================================================
# SMTP E-MAILCONFIGURATIE (Voor nieuwsbrieven, testmails & wachtwoordherstel)
# ==============================================================================
SMTP_HOST=mail.lijstvanandel.nl
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@lijstvanandel.nl
SMTP_PASS=uw_e-mail_wachtwoord
SMTP_FROM="Lijst van Andel" <info@lijstvanandel.nl>

# Google Gemini API Sleutel (voor AI Ondersteuningsdossier & Routering)
GEMINI_API_KEY=

# Optioneel: Zet op 'true' voor betaald tarief zonder 250 RPD daglimiet (~60 RPM verwerking)
GEMINI_PAY_AS_YOU_GO=false
