# .env.example
# Omgevingsvariabelen voor de productie-implementatie op Ubuntu Linux

# Productiemodus
NODE_ENV=production

# Geheime sleutel voor het ondertekenen van JSON Web Tokens (JWT)
# Genereer een veilige willekeurige sleutel op de server met bijvoorbeeld:
# openssl rand -base64 32
JWT_SECRET=vervang_dit_door_een_willekeurige_geheime_sleutel_van_minstens_32_tekens

# Stripe Betalingsintegratie voor Ledencontributie (€12,00 per jaar)
# Te vinden in uw Stripe Dashboard: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_vervang_dit_door_uw_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_vervang_dit_door_uw_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_vervang_dit_door_uw_stripe_webhook_secret

# ==============================================================================
# SMTP E-MAILCONFIGURATIE (Voor automatische e-mails bij wachtwoordherstel & formulieren)
# ==============================================================================
SMTP_HOST=smtp.voorbeeld.nl
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=info@lijstvanandel.nl
SMTP_PASS=
SMTP_FROM="Lijst van Andel" <info@lijstvanandel.nl>
